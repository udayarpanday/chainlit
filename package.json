{
  "devDependencies": {
    "@eslint/compat": "^2.0.3",
    "@eslint/js": "^10.0.0",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "cypress": "^14.5.3",
    "cypress-plugin-steps": "1.2.1",
    "cypress-split": "^1.24.31",
    "dotenv": "^16.3.1",
    "eslint": "^10",
    "eslint-plugin-chai-friendly": "^1.1.1",
    "eslint-plugin-cypress": "^6",
    "fkill": "^9.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.6",
    "kill-port": "^2.0.1",
    "lint-staged": "^13.3.0",
    "prettier": "^3.8.1",
    "shell-exec": "^1.1.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.58.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "husky",
    "build": "pnpm run --recursive build",
    "buildUi": "cd libs/react-client && pnpm run build && cd ../copilot && pnpm run build && cd ../../frontend && pnpm run build",
    "lint": "eslint",
    "lint:fix": "pnpm lint --fix",
    "lintUi": "pnpm run --parallel lint",
    "lintPython": "cd backend && uv run dmypy run --timeout 600 -- chainlit/ tests/",
    "format-check:files": "prettier --check --ignore-unknown",
    "format-check": "pnpm format-check:files .",
    "format:files": "pnpm format-check:files --write",
    "format": "pnpm format-check --write",
    "formatUi": "pnpm run --parallel format",
    "formatPython": "black `git ls-files | grep '.py$'` && isort --profile=black .",
    "type-check": "pnpm run --parallel type-check",
    "test": "pnpm run --recursive test",
    "test:ui": "cd frontend && pnpm test",
    "test:e2e": "cypress run",
    "test:e2e:interactive": "cypress open"
  },
  "pnpm": {
    "overrides": {
      "braces@<3.0.3": ">=3.0.3",
      "micromatch@<4.0.8": ">=4.0.8"
    }
  },
  "dependencies": {
    "react-icons": "^5.4.0"
  },
  "packageManager": "pnpm@9.15.9"
}
