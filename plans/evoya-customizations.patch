+function escapeBrackets(text: string) {
+  const pattern =
+    /(```[\s\S]*?```|`.*?`)|\\\[([\s\S]*?[^\\])\\\]|\\\((.*?)\\\)|(\${1})/g;
+  const res = text.replace(
+    pattern,
+    (match, codeBlock, squareBracket, roundBracket, dollarSign) => {
+      if (codeBlock) {
+        return codeBlock;
+      } else if (squareBracket) {
+        return `$$\n${squareBracket}\n$$`;
+      } else if (roundBracket) {
+        return `$${roundBracket}$`;
+      } else if (dollarSign) {
+        return '\\$';
+      }
+      return match;
+    },
+  );
+  return res;
+}
